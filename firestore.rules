rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mantieni allineata questa lista con ADMIN_EMAILS in "pagina accesso.html"
    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in ['ambrogiani.ai@gmail.com'];
    }

    function isAdminUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function canAccess(uid) {
      return isOwner(uid) || isAdminEmail() || isAdminUser();
    }

    // ── Pagina ospiti (ospiti.html) ────────────────────────────────────────
    // Chi possiede il link puo' SOLO aggiungere task nella coda del titolare:
    // non puo' leggere, modificare o cancellare nulla. Il link vale finche' il
    // token combacia con users/{uid}/meta/ospiti ed e' attivo, quindi il
    // titolare puo' revocarlo rigenerando il token o mettendo attivo=false.
    function guestCfg(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/meta/ospiti).data;
    }

    // Lettura ospite: chi ha il link puo' leggere UN suo compito per ID
    // (solo origine 'ospite' e col token attivo), per vederne lo stato
    // aggiornato quando il titolare lo completa. Nessun accesso al resto.
    function isGuestReadableTask(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/meta/ospiti)
        && guestCfg(uid).token is string
        && guestCfg(uid).token.size() >= 16
        && resource.data.origine == 'ospite'
        && resource.data.gt == guestCfg(uid).token;
    }

    function isValidGuestTask(uid) {
      let d = request.resource.data;
      return exists(/databases/$(database)/documents/users/$(uid)/meta/ospiti)
        && guestCfg(uid).attivo == true
        && guestCfg(uid).token is string
        && guestCfg(uid).token.size() >= 16
        && d.gt == guestCfg(uid).token
        && d.keys().hasOnly(['tipo','titolo','azienda','aziendaId','contatto','tipoInvio','tipoInvioNota','dataInvio','dueDate','stato','esito','note','operatore','origine','gt','createdAt','updatedAt'])
        && d.tipo == 'task'
        && d.origine == 'ospite'
        && d.stato == 'da_fare'
        && d.esito == null
        && d.aziendaId == null
        && d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= 300
        && d.operatore is string && d.operatore.size() > 0 && d.operatore.size() <= 80
        && d.azienda is string && d.azienda.size() <= 200
        && d.note is string && d.note.size() <= 500
        && d.dueDate is string && d.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    match /users/{uid} {
      allow get, list: if canAccess(uid);

      // In creazione: il campo isAdmin puo' essere true solo se l'email e' in ADMIN_EMAILS
      // (impedisce a un utente di auto-promuoversi admin).
      allow create: if isOwner(uid)
        && request.resource.data.isAdmin == isAdminEmail();

      // In aggiornamento: il proprietario non puo' cambiare isAdmin da solo;
      // solo un admin (via isAdminEmail) puo' modificarlo, es. per promuovere altri utenti.
      allow update: if canAccess(uid)
        && (request.resource.data.isAdmin == resource.data.isAdmin || isAdminEmail());

      match /aziende/{docId} {
        allow read, write: if canAccess(uid);
      }

      // Coda "AZIONE": accesso pieno per proprietario/admin.
      // In più gli ospiti muniti di link possono SOLO creare task (nessuna
      // lettura, modifica o cancellazione): vedi isValidGuestTask().
      match /azioni/{docId} {
        allow get: if canAccess(uid) || isGuestReadableTask(uid);
        allow list, update, delete: if canAccess(uid);
        allow create: if canAccess(uid) || isValidGuestTask(uid);
      }

      match /meta/{docId} {
        allow read, write: if canAccess(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
